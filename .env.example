# Grafana Configuration
GRAFANA_BASE_URL=https://your-grafana-instance.example.com

# Authentication (choose one method)
# Option 1: Service Account Token (recommended for programmatic access)
# GRAFANA_AUTH_TOKEN=your_service_account_token_here

# Option 2: Session Cookie (if using OAuth login)
# GRAFANA_SESSION_COOKIE=grafana_session=your_session_cookie_here

# Note: For Google Workspace OAuth, you'll need to:
# 1. Log into Grafana via Google OAuth in your browser
# 2. Extract the session cookie from your browser's developer tools
# 3. Set GRAFANA_SESSION_COOKIE with the session cookie value
# 
# Alternatively, create a service account token in Grafana:
# 1. Go to Administration -> Service Accounts
# 2. Create a new service account
# 3. Add a token and copy it to GRAFANA_AUTH_TOKEN